          "stringUnit": {
            "state": "translated",
            "value": "Estimated surface temperature of the case (TVS sensors). This is what your hand feels. It lags by minutes and keeps rising after the load ends."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розрахункова температура поверхні корпусу (датчики TVS). Саме її відчуває рука. Реагує з затримкою в хвилини і ще росте після зняття навантаження."
          }
        }
