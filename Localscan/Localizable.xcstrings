    "An empty list and zeros mean nothing is running on a local port right now. That is not a fault.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An empty list and zeros mean nothing is running on a local port right now. That is not a fault."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожній список і нулі означають, що зараз не запущено жодного локального сервера. Це не помилка."
          }
        }
      }
    },
    "Another port works if the project reads the PORT variable, as Next, Vite and Express do.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another port works if the project reads the PORT variable, as Next, Vite and Express do."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший порт спрацює, якщо проєкт читає змінну PORT, як це роблять Next, Vite та Express."
          }
        }
      }
    },
    "Apple chip cores heat up and cool down by tens of degrees within seconds, so the instant reading jumps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple chip cores heat up and cool down by tens of degrees within seconds, so the instant reading jumps."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ядра чипа Apple гріються й холонуть на десятки градусів за секунди, тому миттєвий замір скаче."
          }
        }
      }
    },
    "Apps holding over 1 GB, counted the same way as Activity Monitor. Helper processes are added to their app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps holding over 1 GB, counted the same way as Activity Monitor. Helper processes are added to their app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатки, що тримають понад 1 ГБ, пораховано так само, як у Моніторингу системи. Допоміжні процеси додано до свого додатка."
          }
        }
      }
    },
